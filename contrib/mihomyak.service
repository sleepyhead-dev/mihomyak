# systemd unit for running mihomyak on bare metal (root: TUN/gateway capable).
#   install -m 755 mihomyak /usr/local/bin/ && mihomyak core install --dest /usr/local/bin/mihomo
#   install -m 600 examples/config.toml /etc/mihomyak/config.toml   # edit it
#   cp contrib/mihomyak.service /etc/systemd/system/ && systemctl enable --now mihomyak

[Unit]
Description=mihomyak (mihomo supervisor)
Documentation=https://github.com/sleepyhead-dev/mihomyak
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mihomyak run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# SIGTERM to mihomyak only; it stops mihomo (routes cleaned up) within 8 s.
KillMode=mixed
TimeoutStopSec=15s
Environment=MIHOMYAK_CORE_BIN=/usr/local/bin/mihomo
StateDirectory=mihomyak
StateDirectoryMode=0700
Environment=MIHOMYAK_DATA_DIR=/var/lib/mihomyak

# Hardening: only what TUN and binding ports need.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# TUN auto-route writes routing sysctls.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
