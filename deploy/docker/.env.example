# Copy to .env next to the compose file and keep it private (chmod 600).
# Everything here can also go into config.toml; see docs/CONFIG.md.

# Your subscription link (a credential: anyone with it uses your plan).
MIHOMYAK_SUB_URL=https://sub.example.com/REPLACE_ME

# Emulated client: flclashx (default, gets mihomo YAML), koala, happ.
MIHOMYAK_CLIENT=flclashx

# The device the provider sees. Any secret phrase: the same seed is the same
# device (same HWID) on any server and after reinstalls. Without it an id is
# generated on first start and kept in the data volume.
# MIHOMYAK_DEVICE_SEED=long-random-phrase

# Time zone for cron schedules (log timestamps are always UTC).
TZ=Europe/Moscow

# Refresh daily at 05:00 (the subscription is also refreshed at every start).
MIHOMYAK_UPDATE_CRON=0 5 * * *

# Everything goes through the VPN. ru-direct sends Russian sites (.ru, .рф,
# Russian IPs) directly instead.
# MIHOMYAK_RULES_PRESETS=ru-direct

# Drop nodes by name (globs, `;`-separated).
# MIHOMYAK_EXCLUDE=*Россия*;*Info*

# Gateway: while mihomo is down app traffic is blocked instead of going direct.
# MIHOMYAK_KILL_SWITCH=0

# Device name the provider sees (container hostname; Happ sends it as X-Device-Model).
# MIHOMYAK_HOSTNAME=home-server

# Cap mihomo's Go heap on small devices.
# MIHOMYAK_MEMORY_LIMIT=64MiB
