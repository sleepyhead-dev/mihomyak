# Copy to deploy/.env (next to the compose files) and keep it private (chmod 600).

# Your subscription link (a credential: anyone with it uses your plan).
MIHOMYAK_SUB_URL=https://sub.example.com/REPLACE_ME

# Emulated client: flclashx (default, gets mihomo YAML), koala, happ.
MIHOMYAK_CLIENT=flclashx

# Time zone for cron schedules (log timestamps are always UTC).
TZ=Europe/Moscow

# Device name the provider sees (container hostname; Happ sends it as X-Device-Model).
# MIHOMYAK_HOSTNAME=home-server

# Refresh daily at 05:00 and at every container start.
MIHOMYAK_UPDATE_CRON=0 5 * * *
MIHOMYAK_UPDATE_ON_START=1

# Russian sites bypass the proxy.
MIHOMYAK_RULES_PRESETS=ru-direct

# Drop nodes by name (globs, `;`-separated).
# MIHOMYAK_EXCLUDE=*Россия*;*Info*

# Keep a previously registered device: reuse its machine-id (or pin the HWID).
# MIHOMYAK_MACHINE_ID=0d0af05ee8fd4dc29275718f2ce4dff1
# MIHOMYAK_HWID=A3B522EAA6F7DD89

# Cap mihomo's Go heap on small devices.
# MIHOMYAK_MEMORY_LIMIT=64MiB
