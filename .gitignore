# Everything is ignored by default; what belongs to the project is listed below.
/*
!/.github/
!/.gitignore
!/.gitattributes
!/.dockerignore
!/Cargo.toml
!/Cargo.lock
!/CHANGELOG.md
!/Dockerfile
!/LICENSE
!/Makefile
!/README.md
!/README.en.md
!/deny.toml
!/rustfmt.toml
!/contrib/
!/deploy/
!/docs/
!/examples/
!/scripts/
!/src/
!/tests/

# Never tracked, even inside the directories above.
.env
*.rs.bk
