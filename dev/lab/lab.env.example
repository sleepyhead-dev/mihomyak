# Lab settings for dev/lab/compose.yml. Keep the real file OUTSIDE the repo
# (e.g. ~/mihomyak-lab/lab.env, chmod 600): it holds the subscription URL.

# Mock profile (--profile mock):
MIHOMYAK_SUB_URL=http://10.203.0.10:8080/sub/lab

# Real subscription: every new HWID takes a device slot at the provider.
# Reuse the machine-id of a device that is already registered, or accept that
# the lab becomes a new device.
# MIHOMYAK_SUB_URL=https://panel.example/sub/…
# MIHOMYAK_CLIENT=flclashx
# MIHOMYAK_MACHINE_ID=<32 hex>

MIHOMYAK_UPDATE_ON_START=1
MIHOMYAK_LOG=info
